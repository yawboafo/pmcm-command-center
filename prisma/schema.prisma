// Target production schema for the Pizzaman Chickenman operations platform.
// Status: DESIGN — the prototype runs its simulation in the browser; the NestJS
// API that will own this database is the next phase (see docs/ARCHITECTURE.md).
//
// Principles
//  * Every operational row is branch-scoped (branchId) so row-level access can be enforced.
//  * Simulated data never mixes with real data: rows carry `dataSource` and simulation
//    events live in their own tables keyed by SimulationSession.
//  * Events are append-only with client-supplied idempotency keys for deduplication.
//  * Geometry uses PostGIS (Unsupported("geography(Point,4326)")).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum DataSource {
  REAL
  SIMULATED
}

enum FloorPlanFormat {
  A
  B
  C
  CUSTOM
}

enum OrderStatus {
  RECEIVED
  ACCEPTED
  KITCHEN_QUEUE
  PREPARATION
  COOKING
  QUALITY_CHECK
  PACKAGING
  READY
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
  FAILED
  REFUNDED
}

enum Channel {
  WALK_IN
  WEBSITE
  CHRIS_B_APP
  CALL_CENTRE
  DELIVERY_PARTNER
  POS
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum Severity {
  INFO
  WARNING
  CRITICAL
}

// ───────────────────────── Organisation & access ─────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  brands    Brand[]
  regions   Region[]
  users     User[]
  roles     Role[]
  createdAt DateTime @default(now())
}

model Brand {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String // "Pizzaman", "Chickenman", co-located partner brands
  branches       BranchBrand[]

  @@unique([organizationId, name])
}

model Region {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String // one of Ghana's 16 administrative regions
  isoCode        String // e.g. GH-AA
  branches       Branch[]

  @@unique([organizationId, isoCode])
}

model Branch {
  id                 String          @id @default(cuid())
  regionId           String
  region             Region          @relation(fields: [regionId], references: [id])
  code               String          @unique // official branch code from the company directory
  name               String
  city               String?
  location           Unsupported("geography(Point,4326)")?
  coordinateSource   String?
  storeOpen          String?
  storeClose         String?
  deliveryOpen       String?
  deliveryClose      String?
  pickupOnly         Boolean         @default(false)
  siteContext        String?
  sourceUrl          String?
  lastVerifiedAt     DateTime?
  brands             BranchBrand[]
  buildings          Building[]
  equipment          Equipment[]
  workstations       Workstation[]
  virtualCameras     VirtualCamera[]
  physicalCameras    PhysicalCamera[]
  sensors            Sensor[]
  safetyAlerts       SafetyAlert[]
  safetyInspections  SafetyInspection[]
  staffAssignments   StaffAssignment[]
  shifts             Shift[]
  orders             Order[]
  inventoryLocations InventoryLocation[]
  inventoryItems     InventoryItem[]
  deliveries         Delivery[]
  transfersIn        SupplyTransfer[]   @relation("TransferTo")
  simulationSessions SimulationSession[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([regionId])
}

model BranchBrand {
  branchId String
  brandId  String
  branch   Branch @relation(fields: [branchId], references: [id])
  brand    Brand  @relation(fields: [brandId], references: [id])

  @@id([branchId, brandId])
}

model User {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  email          String         @unique
  name           String
  roles          UserRole[]
  auditLogs      AuditLog[]
  createdAt      DateTime       @default(now())
}

model Role {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  key            String // system-admin, national-ops, regional-manager, branch-manager, kitchen-supervisor, food-safety-officer, inventory-manager, viewer
  permissions    RolePermission[]
  users          UserRole[]

  @@unique([organizationId, key])
}

model Permission {
  id    String           @id @default(cuid())
  key   String           @unique // view:branch, act:safety, edit:floorplan, view:cctv, ...
  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

/// A role grant scoped to the whole organisation, a region, or one branch.
model UserRole {
  id       String  @id @default(cuid())
  userId   String
  roleId   String
  user     User    @relation(fields: [userId], references: [id])
  role     Role    @relation(fields: [roleId], references: [id])
  regionId String?
  branchId String?

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  branchId   String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([branchId, createdAt])
  @@index([entityType, entityId])
}

// ───────────────────────── Buildings & digital twin ─────────────────────────

model Building {
  id         String      @id @default(cuid())
  branchId   String
  branch     Branch      @relation(fields: [branchId], references: [id])
  floorPlans FloorPlan[]
}

/// Versioned floor plan. `document` holds the full FloorPlan JSON (schemaVersion 1),
/// which also drives the 2D view, 3D twin, cameras, workflow and sensor layers.
model FloorPlan {
  id           String          @id @default(cuid())
  buildingId   String
  building     Building        @relation(fields: [buildingId], references: [id])
  version      Int
  format       FloorPlanFormat
  conceptual   Boolean         @default(true)
  document     Json
  note         String?
  createdById  String?
  isActive     Boolean         @default(false)
  rooms        Room[]
  walls        Wall[]
  createdAt    DateTime        @default(now())

  @@unique([buildingId, version])
}

model Room {
  id          String    @id @default(cuid())
  floorPlanId String
  floorPlan   FloorPlan @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)
  planKey     String
  name        String
  type        String
  hygieneZone String
  x           Float
  z           Float
  w           Float
  d           Float

  @@unique([floorPlanId, planKey])
}

model Wall {
  id          String    @id @default(cuid())
  floorPlanId String
  floorPlan   FloorPlan @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)
  ax          Float
  az          Float
  bx          Float
  bz          Float
  thickness   Float
  height      Float
  base        Float     @default(0)
  exterior    Boolean
}

model Equipment {
  id                   String          @id @default(cuid())
  branchId             String
  branch               Branch          @relation(fields: [branchId], references: [id])
  planKey              String // id inside the floor plan document
  type                 String
  name                 String
  category             String
  workstationId        String?
  workstation          Workstation?    @relation(fields: [workstationId], references: [id])
  setpointC            Float?
  maintenanceDays      Int?
  lastMaintenanceAt    DateTime?
  sensors              Sensor[]
  inventoryLocations   InventoryLocation[]
  alerts               SafetyAlert[]

  @@unique([branchId, planKey])
}

model Workstation {
  id        String      @id @default(cuid())
  branchId  String
  branch    Branch      @relation(fields: [branchId], references: [id])
  planKey   String
  name      String
  type      String
  capacity  Int
  equipment Equipment[]
  staff     StaffAssignment[]

  @@unique([branchId, planKey])
}

model VirtualCamera {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])
  code     String
  name     String
  pose     Json // position, target, fov from the floor plan

  @@unique([branchId, code])
}

/// Real CCTV — requires authorisation, privacy notice and a streaming gateway.
/// Credentials are stored in a secrets manager; only a reference is kept here.
model PhysicalCamera {
  id               String   @id @default(cuid())
  branchId         String
  branch           Branch   @relation(fields: [branchId], references: [id])
  name             String
  streamGatewayRef String
  secretRef        String
  authorisedById   String
  authorisedAt     DateTime
  privacyNoticeUrl String
  enabled          Boolean  @default(false)
}

// ───────────────────────── Food safety ─────────────────────────

model Sensor {
  id               String          @id @default(cuid())
  branchId         String
  branch           Branch          @relation(fields: [branchId], references: [id])
  equipmentId      String?
  equipment        Equipment?      @relation(fields: [equipmentId], references: [id])
  code             String
  kind             String
  thresholdProfile String?
  dataSource       DataSource
  readings         SensorReading[]

  @@unique([branchId, code])
}

/// High-volume time series; partition by month (or use TimescaleDB) in production.
model SensorReading {
  id         BigInt     @id @default(autoincrement())
  sensorId   String
  sensor     Sensor     @relation(fields: [sensorId], references: [id])
  value      Float?
  connected  Boolean
  recordedAt DateTime
  dataSource DataSource

  @@index([sensorId, recordedAt])
}

model SafetyAlert {
  id                String             @id @default(cuid())
  branchId          String
  branch            Branch             @relation(fields: [branchId], references: [id])
  equipmentId       String?
  equipment         Equipment?         @relation(fields: [equipmentId], references: [id])
  sensorId          String?
  severity          Severity
  title             String
  issue             String
  limitValue        Float?
  peakValue         Float?
  status            AlertStatus        @default(OPEN)
  openedAt          DateTime
  acknowledgedAt    DateTime?
  acknowledgedById  String?
  resolvedAt        DateTime?
  resolvedById      String?
  dataSource        DataSource
  correctiveActions CorrectiveAction[]

  @@index([branchId, status])
}

/// Resolution requires at least one corrective action and an in-range reading (enforced in the service layer).
model CorrectiveAction {
  id         String      @id @default(cuid())
  alertId    String
  alert      SafetyAlert @relation(fields: [alertId], references: [id])
  text       String
  recordedBy String
  recordedAt DateTime    @default(now())
}

model SafetyInspection {
  id          String   @id @default(cuid())
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id])
  kind        String // equipment, cleaning checklist, hygiene, waste, audit
  targetId    String?
  result      String
  notes       String?
  inspectedBy String
  inspectedAt DateTime
}

// ───────────────────────── People ─────────────────────────

model Employee {
  id          String            @id @default(cuid())
  fullName    String
  employeeNo  String            @unique
  training    Json?
  assignments StaffAssignment[]
  shifts      Shift[]
}

model Shift {
  id         String   @id @default(cuid())
  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id])
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  startsAt   DateTime
  endsAt     DateTime
  clockedIn  DateTime?
  clockedOut DateTime?

  @@index([branchId, startsAt])
}

/// Station assignment only — no precise location tracking of real staff.
model StaffAssignment {
  id            String       @id @default(cuid())
  branchId      String
  branch        Branch       @relation(fields: [branchId], references: [id])
  employeeId    String
  employee      Employee     @relation(fields: [employeeId], references: [id])
  workstationId String?
  workstation   Workstation? @relation(fields: [workstationId], references: [id])
  role          String
  from          DateTime
  to            DateTime?
}

model Customer {
  id        String   @id @default(cuid())
  phoneHash String?  @unique // store hashes, not raw phone numbers
  orders    Order[]
  createdAt DateTime @default(now())
}

// ───────────────────────── Menu & orders ─────────────────────────

model MenuItem {
  id         String      @id @default(cuid())
  sku        String      @unique
  name       String
  category   String
  priceGhs   Decimal     @db.Decimal(10, 2)
  active     Boolean     @default(true)
  recipe     Recipe?
  orderItems OrderItem[]
}

model Recipe {
  id         String       @id @default(cuid())
  menuItemId String       @unique
  menuItem   MenuItem     @relation(fields: [menuItemId], references: [id])
  lines      Json // [{ ingredientSku, qty }]
  stages     Json // production stages (station type, duration, machine?)
}

model Order {
  id             String       @id @default(cuid())
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id])
  externalRef    String? // POS / Chris B order id
  number         Int
  channel        Channel
  fulfilment     String
  status         OrderStatus
  totalGhs       Decimal      @db.Decimal(10, 2)
  customerId     String?
  customer       Customer?    @relation(fields: [customerId], references: [id])
  dataSource     DataSource
  inventoryPosted Boolean     @default(false)
  createdAt      DateTime
  readyAt        DateTime?
  completedAt    DateTime?
  items          OrderItem[]
  events         OrderEvent[]
  delivery       Delivery?

  @@unique([branchId, externalRef])
  @@index([branchId, status])
  @@index([branchId, createdAt])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  qty        Int
  unitGhs    Decimal  @db.Decimal(10, 2)
}

/// Append-only order lifecycle; idempotencyKey deduplicates redelivered events.
model OrderEvent {
  id             String      @id @default(cuid())
  orderId        String
  order          Order       @relation(fields: [orderId], references: [id])
  status         OrderStatus
  note           String?
  idempotencyKey String      @unique
  occurredAt     DateTime
  receivedAt     DateTime    @default(now())

  @@index([orderId, occurredAt])
}

// ───────────────────────── Inventory & supply ─────────────────────────

model Supplier {
  id      String          @id @default(cuid())
  name    String
  contact String?
  items   InventoryItem[]
}

model Ingredient {
  id           String          @id @default(cuid())
  sku          String          @unique
  name         String
  unit         String
  storageClass String
  items        InventoryItem[]
}

model InventoryLocation {
  id          String          @id @default(cuid())
  branchId    String
  branch      Branch          @relation(fields: [branchId], references: [id])
  equipmentId String?
  equipment   Equipment?      @relation(fields: [equipmentId], references: [id])
  name        String
  items       InventoryItem[]
}

model InventoryItem {
  id           String                 @id @default(cuid())
  branchId     String
  branch       Branch                 @relation(fields: [branchId], references: [id])
  ingredientId String
  ingredient   Ingredient             @relation(fields: [ingredientId], references: [id])
  locationId   String
  location     InventoryLocation      @relation(fields: [locationId], references: [id])
  supplierId   String?
  supplier     Supplier?              @relation(fields: [supplierId], references: [id])
  qty          Decimal                @db.Decimal(12, 3)
  reorderLevel Decimal                @db.Decimal(12, 3)
  unitCostGhs  Decimal                @db.Decimal(10, 2)
  expiresAt    DateTime?
  transactions InventoryTransaction[]

  @@unique([branchId, ingredientId, locationId])
}

/// Ledger: the unique `key` (e.g. "order:<id>") prevents duplicate stock deductions.
model InventoryTransaction {
  id         String        @id @default(cuid())
  itemId     String
  item       InventoryItem @relation(fields: [itemId], references: [id])
  key        String
  delta      Decimal       @db.Decimal(12, 3)
  reason     String // order, production, receipt, waste, adjustment
  ref        String?
  occurredAt DateTime
  dataSource DataSource

  @@unique([itemId, key])
}

model CentralKitchen {
  id        String          @id @default(cuid())
  name      String
  location  Unsupported("geography(Point,4326)")?
  verified  Boolean         @default(false)
  transfers SupplyTransfer[] @relation("TransferFromKitchen")
}

model Warehouse {
  id        String          @id @default(cuid())
  name      String
  location  Unsupported("geography(Point,4326)")?
  verified  Boolean         @default(false)
  transfers SupplyTransfer[] @relation("TransferFromWarehouse")
}

model SupplyTransfer {
  id              String          @id @default(cuid())
  fromKitchenId   String?
  fromKitchen     CentralKitchen? @relation("TransferFromKitchen", fields: [fromKitchenId], references: [id])
  fromWarehouseId String?
  fromWarehouse   Warehouse?      @relation("TransferFromWarehouse", fields: [fromWarehouseId], references: [id])
  toBranchId      String
  toBranch        Branch          @relation("TransferTo", fields: [toBranchId], references: [id])
  lines           Json
  status          String // requested, scheduled, loading, in-transit, delivered
  departAt        DateTime?
  arriveAt        DateTime?
  dataSource      DataSource
}

model Driver {
  id         String     @id @default(cuid())
  name       String
  courier    String // own dispatch or partner courier
  deliveries Delivery[]
}

/// Rider coordinates are stored only when an authorised live feed exists.
model Delivery {
  id          String    @id @default(cuid())
  branchId    String
  branch      Branch    @relation(fields: [branchId], references: [id])
  orderId     String    @unique
  order       Order     @relation(fields: [orderId], references: [id])
  driverId    String?
  driver      Driver?   @relation(fields: [driverId], references: [id])
  status      String
  collectedAt DateTime?
  deliveredAt DateTime?
  dataSource  DataSource
}

// ───────────────────────── Simulation ─────────────────────────

model SimulationSession {
  id        String            @id @default(cuid())
  branchId  String
  branch    Branch            @relation(fields: [branchId], references: [id])
  seed      Int
  config    Json
  startedAt DateTime          @default(now())
  events    SimulationEvent[]
}

/// Simulation events are kept apart from real operational events by design.
model SimulationEvent {
  id        String            @id @default(cuid())
  sessionId String
  session   SimulationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  seq       Int
  simTime   DateTime
  type      String
  payload   Json

  @@unique([sessionId, seq])
}
