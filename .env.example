# Optional: enables the full Claude-powered assistant (otherwise it runs in offline rule-based mode).
ANTHROPIC_API_KEY=
# Optional: MapTiler key for MapTiler basemaps (default basemap is OpenFreeMap, no key needed).
NEXT_PUBLIC_MAPTILER_KEY=
# Backend (next phase)
DATABASE_URL=postgresql://pmcm:change-me-locally@localhost:5432/pmcm
REDIS_URL=redis://localhost:6379
# Live IoT ingestion: per-device HMAC keys (JSON map deviceId → secret, ≥16 chars). Production: secrets manager + mTLS.
DEVICE_KEYS=
# Optional: require this token for the live stream/status endpoints (Bearer, cookie ops_console, or ?token=)
CONSOLE_ACCESS_TOKEN=
# Camera media gateway (e.g. MediaMTX) base URL for authorised physical cameras
CAMERA_GATEWAY_URL=
# Simulated hardware fleet (npm run hardware:sim). One secret (≥32 chars); each virtual device / POS
# terminal signs with HMAC(VIRTUAL_FLEET_SECRET, id). Generate with: openssl rand -hex 32
VIRTUAL_FLEET_SECRET=
# Optional: simulated camera gateway (npm run camera:sim, default http://127.0.0.1:8090). Falls back to CAMERA_GATEWAY_URL.
VIRTUAL_CAMERA_GATEWAY_URL=
# Shared secret for signed POS / Chris B order webhooks
POS_WEBHOOK_SECRET=
# Optional: STUN server for live camera playback across NAT (e.g. stun:stun.example.org:3478)
NEXT_PUBLIC_STUN_URL=
